clc;
clear;
marks = input("Enter the marks as an array: ");
// Calculate total 
total = sum(marks);
// Calculate average
average = mean(marks);
// Find maximum 
maximum = max(marks);
// Find minimum 
minimum = min(marks);
Display results
disp("Marks = ");
disp(marks);
disp("Total Marks = " +string(total));
disp("Average Marks = " + string(average));
disp("Maximum Mark = " + string(maximum));
 disp("Minimum Mark = " + string(minimum));



f









